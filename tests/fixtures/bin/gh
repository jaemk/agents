#!/usr/bin/env bash
# Minimal `gh` stub for hermetic pr.py tests. Returns canned JSON for exactly the
# calls pr.py makes; performs no network access. Put this dir first on PATH.
#
# Canned repo: acme/widget. Two review comments (one before, one after the cutoff
# of 2020-03-01), one issue comment, two review threads (T1 unresolved, T2 resolved).

set -euo pipefail

sub="${1:-}"; shift || true
args="$*"

case "$sub" in
    repo)
        # gh repo view --json owner,name
        echo '{"owner":{"login":"acme"},"name":"widget"}'
        ;;
    api)
        if [[ "$args" == *graphql* ]]; then
            if [[ "$args" == *reviewThreads* ]]; then
                echo '{"data":{"repository":{"pullRequest":{"reviewThreads":{"nodes":[{"id":"T1","isResolved":false,"comments":{"nodes":[{"databaseId":11,"createdAt":"2020-01-01T00:00:00Z","body":"please fix this"}]}},{"id":"T2","isResolved":true,"comments":{"nodes":[{"databaseId":12,"createdAt":"2020-01-02T00:00:00Z","body":"done"}]}}]}}}}}'
            elif [[ "$args" == *resolveReviewThread* ]]; then
                echo '{"data":{"resolveReviewThread":{"thread":{"id":"T1","isResolved":true}}}}'
            elif [[ "$args" == *minimizeComment* ]]; then
                echo '{"data":{"minimizeComment":{"minimizedComment":{"isMinimized":true,"minimizedReason":"RESOLVED"}}}}'
            else
                echo '{"data":{}}'
            fi
            exit 0
        fi
        case "$args" in
            *commits*)
                # cmd_comments fetches commits as JSON; cmd_minimize fetches with --jq.
                if [[ "$args" == *--jq* ]]; then
                    echo '2020-03-01T00:00:00Z'
                else
                    echo '[{"commit":{"committer":{"date":"2020-03-01T00:00:00Z"}}}]'
                fi
                ;;
            *pulls/*/comments*)
                echo '[{"id":101,"created_at":"2020-01-01T00:00:00Z","path":"src/a.x","line":4,"user":{"login":"rev"},"body":"old review comment","node_id":"C1"},{"id":102,"created_at":"2020-06-01T00:00:00Z","path":"src/b.x","line":9,"user":{"login":"rev"},"body":"new review comment","node_id":"C2"}]'
                ;;
            *issues/*/comments*)
                echo '[{"id":201,"created_at":"2020-01-01T00:00:00Z","user":{"login":"rev"},"body":"issue comment","node_id":"I1"}]'
                ;;
            *requested_reviewers*)
                echo '{}'
                ;;
            *)
                echo '{}'
                ;;
        esac
        ;;
    *)
        echo '{}'
        ;;
esac
