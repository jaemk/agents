# Whitelist backup: ignore everything by default, then re-include tracked dirs/files.
/*

# Top-level
!/.gitignore
!/CLAUDE.md
!/README.md
!/Makefile
!/x
!/mind.toml

# Agents and skills library
!/agents/
!/skills/
!/resources/
!/tests/

# Config backups (user CLAUDE.md, settings.json, keybindings.json)
!/config/

# Only memory/ dirs under projects/ — never session transcripts or other data
!/projects/
/projects/*
!/projects/*/
/projects/*/*
!/projects/*/memory/
